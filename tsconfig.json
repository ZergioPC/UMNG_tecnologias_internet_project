{
  "extends": "astro/tsconfigs/base",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist"
  ],
  "compilerOptions": {
    "noImplicitAny": false,
    "checkJs": false,
    "allowJs": true,
    "paths": {
      "@/*": [
        "./src/*"
      ]
    },
    "jsx": "preserve"
  }
}