---
import DashboardLayout from "@/layouts/DashboardLayout.astro";
import StatCard from "@/components/dashboard/StatCard.astro";
import BadgeEstado from "@/components/dashboard/BadgeEstado.astro";
import GraficoVentas from "@/components/dashboard/GraficoVentas.vue";
import {
  formatearFechaHora,
  obtenerProductosMasVendidos,
  obtenerResumen,
  obtenerUltimosMensajes,
  obtenerUltimosPedidos,
  obtenerVentasPorDia,
} from "@/lib/dashboard.js";
import { formatCOP } from "@/lib/pasarela.js";

const resumen = obtenerResumen();
const serie = obtenerVentasPorDia(14);
const topProductos = obtenerProductosMasVendidos(5);
const ultimosPedidos = obtenerUltimosPedidos(6);
const ultimosMensajes = obtenerUltimosMensajes(4);
const estadoVacio = "Sin pedidos registrados";
const resumenPeriodo = `${serie.pedidosPeriodo} ${
  serie.pedidosPeriodo === 1 ? "pedido" : "pedidos"
} · ${formatCOP(serie.totalPeriodo)}`;
---

<DashboardLayout titulo="Resumen" activo="resumen">
  <section class="kpi-grid" aria-label="Indicadores del negocio">
    <StatCard
      etiqueta="Ventas totales"
      valor={formatCOP(resumen.ventasTotales)}
      detalle={`Hoy: ${formatCOP(resumen.ventasHoy)}`}
      tono="primary"
    />
    <StatCard
      etiqueta="Pedidos"
      valor={resumen.pedidos}
      detalle={`${resumen.pedidosSemana} en los últimos 7 días`}
    />
    <StatCard
      etiqueta="Ticket promedio"
      valor={formatCOP(resumen.ticketPromedio)}
      detalle="Sobre pedidos no cancelados"
    />
    <StatCard
      etiqueta="Pendientes"
      valor={resumen.pendientes}
      detalle={resumen.pendientes > 0
        ? "Requieren seguimiento"
        : "Todo al día"}
      tono={resumen.pendientes > 0 ? "accent" : "default"}
    />
    <StatCard
      etiqueta="Mensajes"
      valor={resumen.mensajes}
      detalle={`${resumen.mensajesSemana} en los últimos 7 días`}
    />
  </section>

  <section class="panel-grid">
    <article class="card">
      <header class="card__header">
        <div class="card__header-text">
          <h2 class="card__title">Ventas de los últimos 14 días</h2>
          <p class="card__subtitle">{resumenPeriodo}</p>
        </div>
        <a class="card__link" href="/dashboard/pedidos">Ver pedidos</a>
      </header>

      <div class="card__body">
        <div class="chart-wrap">
          <GraficoVentas
            client:only="vue"
            etiquetas={serie.etiquetas}
            valores={serie.totales}
          />
        </div>

        <details class="chart-data">
          <summary>Ver datos del gráfico</summary>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th>Día</th>
                  <th class="num">Pedidos</th>
                  <th class="num">Ventas</th>
                </tr>
              </thead>
              <tbody>
                {
                  serie.etiquetas.map((etiqueta, indice) => (
                    <tr>
                      <td>{etiqueta}</td>
                      <td class="num">{serie.pedidos[indice]}</td>
                      <td class="num">{formatCOP(serie.totales[indice])}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </details>
      </div>
    </article>

    <article class="card">
      <header class="card__header">
        <div class="card__header-text">
          <h2 class="card__title">Productos más vendidos</h2>
          <p class="card__subtitle">Unidades acumuladas</p>
        </div>
        <a class="card__link" href="/dashboard/productos">Catálogo</a>
      </header>

      <div class="card__body">
        {
          topProductos.length > 0 ? (
            <ul class="top-list">
              {topProductos.map((producto, indice) => (
                <li class="top-item">
                  <span class="top-item__rank">{indice + 1}</span>
                  {producto.imagen ? (
                    <img
                      class="top-item__img"
                      src={producto.imagen}
                      alt=""
                      width="42"
                      height="42"
                      loading="lazy"
                    />
                  ) : (
                    <span class="top-item__img" aria-hidden="true" />
                  )}
                  <span class="top-item__info">
                    <span class="top-item__name">{producto.nombre}</span>
                    <span class="top-item__meta">
                      {producto.cantidad} unidades vendidas
                    </span>
                  </span>
                  <span class="top-item__value">
                    {formatCOP(producto.ingresos)}
                  </span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="empty">
              <span class="empty__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <path d="M4 11h16a8 8 0 0 1-8 8 8 8 0 0 1-8-8Z" />
                  <path d="M9 7c0-1.5 1-2 1-3M13 7c0-1.5 1-2 1-3" />
                </svg>
              </span>
              <strong>Aún no hay ventas</strong>
              <p>Los productos aparecerán aquí cuando se registren pedidos.</p>
            </div>
          )
        }
      </div>
    </article>
  </section>

  <section class="panel-grid panel-grid--even">
    <article class="card">
      <header class="card__header">
        <div class="card__header-text">
          <h2 class="card__title">Últimos pedidos</h2>
          <p class="card__subtitle">Los 6 movimientos más recientes</p>
        </div>
        <a class="card__link" href="/dashboard/pedidos">Ver todos</a>
      </header>

      <div class="card__body card__body--flush">
        <div class="table-wrap">
          <table class="table">
            <thead>
              <tr>
                <th>Referencia</th>
                <th>Cliente</th>
                <th class="num">Total</th>
                <th>Estado</th>
              </tr>
            </thead>
            <tbody>
              {
                ultimosPedidos.length > 0 ? (
                  ultimosPedidos.map((pedido) => (
                    <tr>
                      <td>
                        <span class="mono">{pedido.referencia}</span>
                        <span class="order-date">{pedido.fechaTexto}</span>
                      </td>
                      <td>{pedido.nombre}</td>
                      <td class="num">{formatCOP(pedido.total)}</td>
                      <td>
                        <BadgeEstado estado={pedido.estado} />
                      </td>
                    </tr>
                  ))
                ) : (
                  <tr>
                    <td colspan="4" class="table-empty">
                      {estadoVacio}
                    </td>
                  </tr>
                )
              }
            </tbody>
          </table>
        </div>
      </div>
    </article>

    <article class="card">
      <header class="card__header">
        <div class="card__header-text">
          <h2 class="card__title">Mensajes recientes</h2>
          <p class="card__subtitle">Formulario de contacto</p>
        </div>
        <a class="card__link" href="/dashboard/mensajes">Ver todos</a>
      </header>

      <div class="card__body">
        {
          ultimosMensajes.length > 0 ? (
            <ul class="mini-list">
              {ultimosMensajes.map((mensaje) => (
                <li class="mini-item">
                  <div class="mini-item__head">
                    <span class="mini-item__name">{mensaje.nombre}</span>
                    <span class="mini-item__date">
                      {formatearFechaHora(mensaje.fecha)}
                    </span>
                  </div>
                  <span class="mini-item__text">{mensaje.mensaje}</span>
                </li>
              ))}
            </ul>
          ) : (
            <div class="empty">
              <span class="empty__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3.5 6.5 8.5 6 8.5-6" />
                </svg>
              </span>
              <strong>Sin mensajes</strong>
              <p>Los mensajes del formulario de contacto se verán aquí.</p>
            </div>
          )
        }
      </div>
    </article>
  </section>
</DashboardLayout>
