                </div>
            </div>
        </div>
    </div>
    <div class="container footer-bottom">
        <p class="footer-copyright">© 2026 Los Chinos Hermanos. Todos los derechos reservados.</p>
    </div>
</footer>

<style>
.footer-main {
  margin-bottom: 0;
  border-radius: 0;
  border: none;
  box-shadow: none;
  background-color: #9c2212;
  color: #fff;
  padding-top: 40px;
  padding-bottom: 20px;
}
.footer-main .row {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
}

.footer-main .row::before,
.footer-main .row::after {
  display: none;
}

.footer-main .row > div {
  float: none;
  width: auto;
}

.footer-brand {
  text-align: center;
}

.section-title-sm {
  border-bottom: 2px solid #fff;
  padding-bottom: 6px;
  text-transform: uppercase;
  display: inline-block;
  color: #fff;
}

.footer-logo {
  display: block;
  height: 120px;
  width: auto;
  max-width: 100%;
  margin: 15px auto 0;
}

.footer-brand-text {
  font-weight: bold;
  font-size: 1.1rem;
  color: #fff;
  border: none;
  text-transform: none;
  margin: 0;
}

.footer-main p {
  color: #fff;
}

.footer-main a:not(.footer-social-icon) {
  color: #fff;
  text-decoration: none;
}

.footer-main a:not(.footer-social-icon):hover {
  text-decoration: underline;
}

.footer-social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 44px;
  height: 44px;
  border-radius: 50%;
  border: 2px solid #fff;
  background-color: #fff;
  color: #9c2212;
  margin-right: 8px;
  transition: all 0.2s ease;
}

.section-title-sm + div {
  margin-top: 15px;
}
.footer-social-icon svg {
  width: 22px;
  height: 22px;
}

.footer-social-icon:hover {
  background-color: #701609;
  border-color: #fff;
  color: #fff;
  transform: translateY(-2px);
}

.footer-bottom {
  margin-top: 20px;
  padding-top: 15px;
  border-top: 1px solid rgba(255, 255, 255, 0.35);
  text-align: center;
}

.footer-copyright {
  font-size: 13px;
  color: #fff;
  margin: 0;
}

/* Responsive: tablets y celulares */
/* Tablets y celulares */
@media (max-width: 991px) {
  .footer-main {
    text-align: center;
    padding-top: 30px;
  }

  .footer-main .row {
    justify-content: center;
    gap: 30px 60px;
  }
}

/* Celulares */
@media (max-width: 767px) {
  .footer-logo {
    height: 90px;
  }

  .footer-social-icon {
    margin: 0 4px;
  }
}
</style>
