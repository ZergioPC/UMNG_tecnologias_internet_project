---
// src/components/Footer.astro
import logo from "@/assets/img/logo.png";
---

<footer class="well footer-main">
    <div class="container">
        <div class="row">
            <div class="col-sm-6 col-md-3">
                <h4 class="section-title-sm">LOGO</h4>
                <img src={logo.src} alt="Logo Los Chinos Hermanos" class="footer-logo">
                <p class="footer-brand-text">Los Chinos Hermanos</p>
            </div>
            <div class="col-sm-6 col-md-3">
                <h4 class="section-title-sm">MENU</h4>
                <p>Link 1</p>
                <p>Link 2</p>
                <p>Link 3</p>
            </div>
            <div class="col-sm-6 col-md-3">
                <h4 class="section-title-sm">CONTACTO</h4>
                <p>Dato 1</p>
                <p>Dato 2</p>
                <p>Dato 3</p>
            </div>
            <div class="col-sm-6 col-md-3">
                <h4 class="section-title-sm">SIGUENOS</h4>
                <div>
                    <span class="footer-social-icon">X</span>
                    <span class="footer-social-icon">X</span>
                    <span class="footer-social-icon">X</span>
                </div>
            </div>
        </div>
    </div>
    <div class="container footer-bottom">
        <p class="footer-copyright">© 2026 Los Chinos Hermanos. Todos los derechos reservados.</p>
    </div>
</footer>


<style>
.section-title-sm {
  border-bottom: 2px solid #333;
  padding-bottom: 6px;
  text-transform: uppercase;
  display: inline-block;
}

.footer-main {
  margin-bottom: 0;
  border-radius: 0;
  border-top: 1px solid #ddd;
  background-color: #f8f9fa;
}

.footer-logo {
  max-height: 50px;
  margin-bottom: 10px;
}

.footer-brand-text {
  font-weight: bold;
}

.footer-bottom {
  margin-top: 20px;
  padding-top: 15px;
  border-top: 1px solid #ddd;
  text-align: center;
}

.footer-copyright {
  font-size: 13px;
  color: #666;
}

.footer-social-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  border: 1px solid #ccc;
  background-color: #fff;
  font-weight: bold;
  margin-right: 5px;
}

.footer-social-icon:hover {
  background-color: #e9ecef;
}
</style>