---
const productos = [
  { id: 1, nombre: "Producto 1", placeholder: "IMG 1" },
  { id: 2, nombre: "Producto 2", placeholder: "IMG 2" },
  { id: 3, nombre: "Producto 3", placeholder: "IMG 3" },
  { id: 4, nombre: "Producto 4", placeholder: "IMG 4" },
  { id: 5, nombre: "Producto 5", placeholder: "IMG 5" },
  { id: 6, nombre: "Producto 6", placeholder: "IMG 6" },
  { id: 7, nombre: "Producto 7", placeholder: "IMG 7" },
  { id: 8, nombre: "Producto 8", placeholder: "IMG 8" },
  { id: 9, nombre: "Producto 9", placeholder: "IMG 9" },
  { id: 10, nombre: "Producto 10", placeholder: "IMG 10" },
  { id: 11, nombre: "Producto 11", placeholder: "IMG 11" },
  { id: 12, nombre: "Producto 12", placeholder: "IMG 12" },
  { id: 13, nombre: "Producto 13", placeholder: "IMG 13" },
  { id: 14, nombre: "Próximamente", placeholder: "PROX" },
];

const platosPrincipales = [
  "Arroz Especial",
  "Chop Suey Especial",
  "Pollo Broaster Entero",
];

const snacks = [
  "Yuca frita",
  "Dumplings",
];

const recomendados = [
  { id: 1, titulo: "Recomendado 1", descripcion: "Descripción del primer producto.", placeholder: "IMAGEN 1" },
  { id: 2, titulo: "Recomendado 2", descripcion: "Descripción del segundo producto.", placeholder: "IMAGEN 2" },
  { id: 3, titulo: "Recomendado 3", descripcion: "Descripción del tercer producto.", placeholder: "IMAGEN 3" },
  { id: 4, titulo: "Recomendado 4", descripcion: "Descripción del cuarto producto.", placeholder: "IMAGEN 4" },
  { id: 5, titulo: "Recomendado 5", descripcion: "Descripción del quinto producto.", placeholder: "IMAGEN 5" },
];

const precios = [
  { plato: "Arroz Especial", precio: "$10.000" },
  { plato: "Chop Suey Especial", precio: "$35.000" },
  { plato: "Pollo Broaster Entero", precio: "$15.000" },
  { plato: "Yuca frita", precio: "$15.500" },
  { plato: "Dumplings", precio: "$25.000" },
];
---

<section class="container section-spacing">
  <h2>NUESTRO MENU</h2>
  <div class="row">
    {productos.map((producto, index) => (
      <div class={`col-xs-6 col-sm-4 col-md-3 card-item ${index >= 8 ? "menu-item-extra" : ""}`}>
        <div class="thumbnail">
          <div class="menu-img-placeholder">{producto.placeholder}</div>
          <div class="caption text-center">
            <a class="card-link" href="#">{producto.nombre}</a>
          </div>
        </div>
      </div>
    ))}
  </div>
  <div class="text-center" style="margin-top: 20px;">
    <button id="btn-toggle-menu" class="btn btn-default btn-lg">Ver más</button>
  </div>
</section>

<section class="container section-spacing">
  <div class="panel panel-default">
    <div class="panel-body">
      <div class="row">
        <div class="col-sm-6">
          <h3>PLATOS PRINCIPALES</h3>
          <ul class="list-group">
            {platosPrincipales.map((plato) => (
              <li class="list-group-item">{plato}</li>
            ))}
          </ul>
        </div>
        <div class="col-sm-6">
          <h3>SNACKS Y APERITIVOS</h3>
          <ul class="list-group">
            {snacks.map((snack) => (
              <li class="list-group-item">{snack}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="container section-spacing">
  <div class="recomendados-header">
    <h2 class="section-title">RECOMENDADOS</h2>
    <div class="carousel-controls">
      <button id="carousel-prev" class="carousel-btn" aria-label="Anterior">&larr;</button>
      <button id="carousel-next" class="carousel-btn" aria-label="Siguiente">&rarr;</button>
    </div>
  </div>
  <div class="recomendados-carousel" id="recomendados-slider">
    {recomendados.map((item) => (
      <div class="recomendados-slide">
        <div class="thumbnail">
          <div class="recomendado-img-placeholder">{item.placeholder}</div>
          <div class="caption">
            <h4><a href="#">{item.titulo}</a></h4>
            <p>{item.descripcion}</p>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="container section-spacing">
  <h3 class="section-title">Tabla de precios</h3>
  <div class="table-responsive">
    <table class="table table-striped table-bordered">
      <thead>
        <tr>
          <th>Plato</th>
          <th>Precio</th>
        </tr>
      </thead>
      <tbody>
        {precios.map((item) => (
          <tr>
            <td>{item.plato}</td>
            <td>{item.precio}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<section class="container section-spacing-bottom">
  <h3 class="section-title">Contactenos</h3>
  <div class="row">
    <div class="col-sm-8 col-md-6">
      <form action="#" method="post">
        <div class="form-group">
          <label for="nombre">Nombre completo</label>
          <input type="text" class="form-control" id="nombre" name="nombre" required />
        </div>
        <div class="form-group">
          <label for="correo">Correo electronico</label>
          <input type="email" class="form-control" id="correo" name="correo" required />
        </div>
        <div class="form-group">
          <label for="mensaje">Mensaje</label>
          <textarea class="form-control" id="mensaje" rows="4"></textarea>
        </div>
        <button type="submit" class="btn btn-default">Enviar</button>
      </form>
    </div>
  </div>
</section>

<script>
  const btnToggle = document.getElementById("btn-toggle-menu");
  const extraItems = document.querySelectorAll(".menu-item-extra");
  let isMenuExpanded = false;

  btnToggle?.addEventListener("click", () => {
    isMenuExpanded = !isMenuExpanded;
    extraItems.forEach((item) => item.classList.toggle("show", isMenuExpanded));
    btnToggle.textContent = isMenuExpanded ? "Ver menos" : "Ver más";
  });

  const slider = document.getElementById("recomendados-slider");
  const prevBtn = document.getElementById("carousel-prev");
  const nextBtn = document.getElementById("carousel-next");

  prevBtn?.addEventListener("click", () => {
    if (slider) {
      const slide = slider.querySelector(".recomendados-slide") as HTMLElement;
      const step = slide ? slide.offsetWidth + 20 : 260;
      slider.scrollBy({ left: -step, behavior: "smooth" });
    }
  });

  nextBtn?.addEventListener("click", () => {
    if (slider) {
      const slide = slider.querySelector(".recomendados-slide") as HTMLElement;
      const step = slide ? slide.offsetWidth + 20 : 260;
      slider.scrollBy({ left: step, behavior: "smooth" });
    }
  });
</script>
