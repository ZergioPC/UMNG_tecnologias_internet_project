---
import FormContact from "./FormContact.astro";
import CarruselRecomendados from "./CarruselRecomendados.vue";
import MenuProductos from "./MenuProductos.vue";

const platosPrincipales = [
  "Arroz Especial Mixto",
  "Chop Suey Mixto",
  "Costillitas Glaseadas",
  "Pollo Agridulce",
  "Fideos Chow Mein"
];

const snacks = [
  "Dumplings al Vapor (Jiaozi)",
  "Rollitos Primavera Crocantes",
  "Wantán Frito Tradicional",
  "Yuca Frita con Salsa Oriental"
];

const precios = [
  { plato: "Arroz Especial Mixto", precio: "$28.000" },
  { plato: "Chop Suey Mixto", precio: "$32.000" },
  { plato: "Costillitas Glaseadas", precio: "$34.000" },
  { plato: "Dumplings al Vapor (6 uds)", precio: "$18.000" },
  { plato: "Fideos Chow Mein", precio: "$25.000" },
  { plato: "Pollo Agridulce", precio: "$26.000" },
  { plato: "Rollitos Primavera (4 uds)", precio: "$15.000" },
  { plato: "Wantán Frito (8 uds)", precio: "$16.000" },
];
---

<!-- 1. Carrusel de Platos Recomendados (Vue 3 Island) -->
<CarruselRecomendados client:visible />

<!-- 2. Catálogo Interactivo con Buscador y Filtros (Vue 3 Island) -->
<MenuProductos client:visible />

<!-- 3. Categorías y Especialidades -->
<section id="categorias" class="container section-spacing">
  <div class="categorias-panel">
    <div class="row">
      <div class="col-sm-6">
        <div class="categoria-box">
          <div class="categoria-box-header">
            <span class="categoria-icono">🥢</span>
            <h3 class="categoria-titulo">Platos Principales</h3>
          </div>
          <ul class="list-group">
            {platosPrincipales.map((plato) => (
              <li class="list-group-item">
                <span class="item-bullet">&#10003;</span>
                <span>{plato}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="col-sm-6">
        <div class="categoria-box">
          <div class="categoria-box-header">
            <span class="categoria-icono">🥟</span>
            <h3 class="categoria-titulo">Snacks y Entradas</h3>
          </div>
          <ul class="list-group">
            {snacks.map((snack) => (
              <li class="list-group-item">
                <span class="item-bullet">&#10003;</span>
                <span>{snack}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 4. Tabla de Precios -->
<section id="precios" class="container section-spacing">
  <div class="precios-card">
    <div class="precios-header">
      <span class="precios-badge">TARIFAS ACTUALIZADAS</span>
      <h3 class="section-title">Lista Oficial de Precios</h3>
      <p class="precios-sub">Precios netos en pesos colombianos (COP). Incluyen todos los impuestos.</p>
    </div>
    <div class="table-responsive">
      <table class="table-precios-custom">
        <thead>
          <tr>
            <th>Plato</th>
            <th class="text-right">Precio COP</th>
          </tr>
        </thead>
        <tbody>
          {precios.map((item, idx) => (
            <tr class={idx % 2 === 0 ? "fila-par" : "fila-impar"}>
              <td>
                <strong>{item.plato}</strong>
              </td>
              <td class="text-right precio-destacado">{item.precio}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- 5. Formulario de Contacto -->
<section id="contacto" class="container section-spacing-bottom">
  <div class="contacto-wrapper">
    <h3 class="section-title">¿Tienes preguntas o deseas reservar?</h3>
    <p class="contacto-sub">Déjanos tu mensaje y nos pondremos en contacto contigo a la brevedad.</p>
    <div class="row">
      <div class="col-sm-10 col-md-8 col-lg-6">
        <FormContact />
      </div>
    </div>
  </div>
</section>

<style>
.section-spacing {
  margin-top: 50px;
  max-width: 1140px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 1rem;
}

.section-spacing-bottom {
  margin-top: 50px;
  margin-bottom: 70px;
  max-width: 1140px;
  margin-left: auto;
  margin-right: auto;
  padding: 0 1rem;
}

.section-title {
  font-size: 1.8rem;
  font-weight: 800;
  color: #111827;
  margin-top: 0;
  margin-bottom: 0.5rem;
}

/* Categorias */
.categorias-panel {
  background: #ffffff;
  border-radius: 16px;
  padding: 2rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
}

.categoria-box {
  background: #fafafa;
  border-radius: 12px;
  padding: 1.5rem;
  height: 100%;
  border: 1px solid #f0f0f0;
}

.categoria-box-header {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  margin-bottom: 1.25rem;
  border-bottom: 2px solid #b12715;
  padding-bottom: 0.5rem;
}

.categoria-icono {
  font-size: 1.6rem;
}

.categoria-titulo {
  font-size: 1.25rem;
  font-weight: 700;
  color: #111827;
  margin: 0;
}

.list-group {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.6rem;
}

.list-group-item {
  display: flex;
  align-items: center;
  gap: 0.6rem;
  font-size: 0.95rem;
  color: #374151;
  padding: 0.5rem 0.75rem;
  background: #ffffff;
  border-radius: 8px;
  border: 1px solid #e5e7eb;
}

.item-bullet {
  color: #16a34a;
  font-weight: bold;
}

/* Precios */
.precios-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 2.25rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
}

.precios-header {
  margin-bottom: 1.5rem;
}

.precios-badge {
  font-size: 0.75rem;
  font-weight: 800;
  color: #b12715;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 0.25rem;
}

.precios-sub {
  color: #6b7280;
  font-size: 0.95rem;
  margin: 0;
}

.table-precios-custom {
  width: 100%;
  border-collapse: collapse;
  font-size: 0.95rem;
}

.table-precios-custom th {
  background: #f9fafb;
  color: #374151;
  font-weight: 700;
  padding: 0.85rem 1.25rem;
  border-bottom: 2px solid #e5e7eb;
  text-align: left;
}

.table-precios-custom th.text-right,
.table-precios-custom td.text-right {
  text-align: right;
}

.table-precios-custom td {
  padding: 0.85rem 1.25rem;
  border-bottom: 1px solid #f3f4f6;
  color: #1f2937;
}

.fila-par {
  background-color: #ffffff;
}

.fila-impar {
  background-color: #fdfdfd;
}

.precio-destacado {
  color: #b12715;
  font-weight: 800;
  font-size: 1.05rem;
}

/* Contacto */
.contacto-wrapper {
  background: #ffffff;
  border-radius: 16px;
  padding: 2.25rem;
  border: 1px solid #e5e7eb;
  box-shadow: 0 4px 15px rgba(0, 0, 0, 0.04);
}

.contacto-sub {
  color: #6b7280;
  margin-bottom: 1.5rem;
}
</style>
