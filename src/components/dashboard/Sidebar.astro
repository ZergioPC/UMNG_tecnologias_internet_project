---
import logo from "@/assets/img/logo.png";

const { activo = "resumen" } = Astro.props;

const enlaces = [
  {
    id: "resumen",
    href: "/dashboard",
    etiqueta: "Resumen",
    icono:
      '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>',
  },
  {
    id: "pedidos",
    href: "/dashboard/pedidos",
    etiqueta: "Pedidos",
    icono:
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12a1 1 0 0 1 1 1v17l-3-2-2 2-2-2-2 2-2-2-3 2V4a1 1 0 0 1 1-1Z"/><path d="M9 8h6M9 12h6M9 16h3"/></svg>',
  },
  {
    id: "mensajes",
    href: "/dashboard/mensajes",
    etiqueta: "Mensajes",
    icono:
      '<svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3.5 6.5 8.5 6 8.5-6"/></svg>',
  },
  {
    id: "productos",
    href: "/dashboard/productos",
    etiqueta: "Productos",
    icono:
      '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h16a8 8 0 0 1-8 8 8 8 0 0 1-8-8Z"/><path d="M9 7c0-1.5 1-2 1-3M13 7c0-1.5 1-2 1-3"/></svg>',
  },
];
---

<aside id="dash-sidebar" class="dash-sidebar" aria-label="Navegación del panel">
  <a class="dash-brand" href="/dashboard">
    <img src={logo.src} alt="Los Chinos Hermanos" width="42" height="42" />
    <span class="dash-brand-text">
      <strong>Los Chinos Hermanos</strong>
      <span>Panel administrativo</span>
    </span>
  </a>

  <nav class="dash-nav">
    <ul>
      {
        enlaces.map((enlace) => (
          <li>
            <a
              href={enlace.href}
              class:list={[
                "dash-nav-link",
                { active: activo === enlace.id },
              ]}
              aria-current={activo === enlace.id ? "page" : undefined}
            >
              <span class="dash-nav-icon" aria-hidden="true">
                <Fragment set:html={enlace.icono} />
              </span>
              {enlace.etiqueta}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="dash-sidebar-footer">
    <span>Panel de solo lectura</span>
    <a href="/">← Volver a la tienda</a>
  </div>
</aside>

<div id="dash-overlay" class="dash-overlay"></div>
